 "profiles": {
  "token": {
   "about": "Wi-Fi firmware at Token and Signed that takes its key over USB: the MicroPython helper warblet.py, the Arduino library.",
   "caps": "{\"v\":1,\"auth\":[1,2],\"keyProvisioning\":[\"usb\"],\"otaKeyRotation\":false,\"otaFirmwareUpdate\":false,\"transports\":[\"https\"]}",
   "accepts": [
    "ssid",
    "pass",
    "aps",
    "hwid",
    "host",
    "claim",
    "token",
    "key"
   ]
  },
  "open": {
   "about": "The Open starter: Wi-Fi and an id, no credential, no key. Its host is fixed in main.py, so a host push is taken only when it names that host.",
   "caps": "{\"v\":1,\"auth\":[0],\"keyProvisioning\":[],\"otaKeyRotation\":false,\"otaFirmwareUpdate\":false,\"transports\":[\"http\"]}",
   "accepts": [
    "ssid",
    "pass",
    "aps",
    "hwid",
    "host"
   ],
   "host": "http.warbletiot.com"
  }
 },
