{
 "_": "CHIRP-PROV v1.8 test vectors (the Warblet contract, Serial provisioning). One file for every reader of the protocol: the checks over the demos, every firmware family's host tests and the setup page's parser. caps: objects that are and are not a capability object. announce: lines that carry a capability report (with what it says) and lines that carry none. pushes: a setup push to a responder of a profile, with the settings it holds, the answer it must print, and whether it stores anything; a refused push leaves the settings it holds as they were. Every id, code and key here is a test value.",
 "protocol": "chirp-prov/1.8",
 "keyOrder": [
  "v",
  "auth",
  "keyProvisioning",
  "otaKeyRotation",
  "otaFirmwareUpdate",
  "transports"
 ],
 "bounds": {
  "caps": 256,
  "line": 512
 },
 "fwPattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
 "fieldNamePattern": "^[A-Za-z0-9_.-]{1,32}$",
